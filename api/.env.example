# Usado ao rodar a API fora do Docker (npm run dev), com postgres e minio do compose.
NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://leilao:leilao@localhost:5432/leilao?schema=public

REDIS_URL=redis://localhost:6379
REDIS_ROOM_TTL_SECONDS=86400

JWT_SECRET=troque-este-segredo-em-producao-123456
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=auction-photos
S3_FORCE_PATH_STYLE=true

# RF15: prorrogação de lance de última hora.
AUCTION_EXTENSION_WINDOW_SECONDS=120
AUCTION_EXTENSION_SECONDS=120
AUCTION_MAX_EXTENSION_SECONDS=1800

# RF09: lances recentes no snapshot da sala.
AUCTION_RECENT_BIDS_LIMIT=20

# Regra de queda: ao subir, leilões Em andamento viram Cancelados (false para desligar em dev).
AUCTION_CANCEL_RUNNING_ON_BOOT=true

# Lances: anti-rajada (ms entre lances do mesmo usuário) e validade da chave de idempotência.
BID_THROTTLE_MS=500
BID_IDEMPOTENCY_TTL_SECONDS=86400

# Rate limit de login/cadastro por IP.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Limites de leilão e fotos (RF06). Tempos em segundos.
AUCTION_MIN_LEAD_SECONDS=60
AUCTION_MAX_LEAD_SECONDS=2592000
AUCTION_MIN_DURATION_SECONDS=60
AUCTION_MAX_DURATION_SECONDS=604800
AUCTION_EDIT_LOCK_SECONDS=1800
AUCTION_TICK_MS=1000
AUCTION_MAX_ITEMS=10
ITEM_MIN_PHOTOS=3
ITEM_MAX_PHOTOS=10
PHOTO_MAX_BYTES=5242880
