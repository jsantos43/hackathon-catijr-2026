# Usado ao rodar a API fora do Docker (npm run dev), com postgres e minio do compose.
NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://leilao:leilao@localhost:5432/leilao?schema=public

JWT_SECRET=troque-este-segredo-em-producao-123456
JWT_EXPIRES_IN=2h

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=auction-photos
S3_FORCE_PATH_STYLE=true
