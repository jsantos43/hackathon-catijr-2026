# Variáveis do compose.yml (todas têm valor padrão; copie para .env para sobrescrever).
POSTGRES_USER=leilao
POSTGRES_PASSWORD=leilao
POSTGRES_DB=leilao
POSTGRES_PORT=5432

MINIO_IMAGE=cgr.dev/chainguard/minio:latest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001


API_PORT=3333
# Seu uid/gid no host (rode `id -u` e `id -g`), para o container criar arquivos como você.
HOST_UID=1000
HOST_GID=1000
