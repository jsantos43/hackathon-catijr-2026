# Variáveis do compose.yml (todas têm valor padrão; copie para .env para sobrescrever).
POSTGRES_USER=leilao
POSTGRES_PASSWORD=leilao
POSTGRES_DB=leilao
POSTGRES_PORT=5432

REDIS_PORT=6379

API_PORT=3333
# Seu uid/gid no host (rode `id -u` e `id -g`), para o container criar arquivos como você.
HOST_UID=1000
HOST_GID=1000

# --- Produção (compose.prod.yml / deploy.sh) ---
# O deploy.sh cria este arquivo no servidor na primeira vez.
# Não use o JWT padrão em produção. As fotos são servidas pelo nginx em ${PUBLIC_URL}/uploads.
# PUBLIC_URL=https://leilao.exemplo.com
# JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
# APP_PORT=8080
